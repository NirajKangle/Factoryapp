# Comma-separated n8n (or other) webhook URLs — fired after every status change
WEBHOOK_URL=http://localhost:5678/webhook/myfactory-status

# Optional shared secret (sent as X-Webhook-Secret)
# WEBHOOK_SECRET=change-me

# WEBHOOK_TIMEOUT_SEC=5

