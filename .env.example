# Copy this file to .env — app.py loads it automatically on startup
# Comma-separated n8n (or other) webhook URLs — fired after every status change
WEBHOOK_URL=http://localhost:5678/webhook/werqr-status

# Start local n8n via "npx n8n" when port 5678 is not already in use
AUTO_START_N8N=true

# Optional shared secret (sent as X-Webhook-Secret)
# WEBHOOK_SECRET=change-me

# WEBHOOK_TIMEOUT_SEC=5

# DEFAULT_AUTHOR_NAME=Shop Floor
# DEFAULT_ASSIGNEE_NAME=Alex Chen
